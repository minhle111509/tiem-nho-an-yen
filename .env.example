# Copy this file to ".env" and fill in real values. NEVER commit .env to GitHub.

# Google Gemini API key for "AI gợi ý sản phẩm" in the admin page (optional).
# Get one free at https://aistudio.google.com/apikey . Without it, the shop still works
# and the AI button returns a preset suggestion instead.
GEMINI_API_KEY=""

# Gemini model used for product suggestions (optional, default: gemini-3.8-flash)
# GEMINI_MODEL="gemini-3.8-flash"

# Admin PIN (6 digits). If set, it overrides the PIN saved in Admin > Cài đặt.
# Strongly recommended when the site is online; the built-in default is 123456.
ADMIN_PIN=""

# Port the server listens on (hosting providers usually set this automatically)
# PORT=3000

# Folder holding store.json (products, orders, settings). Default: ./data
# Point it to a persistent disk on your hosting so orders survive redeploys.
# DATA_DIR="./data"
